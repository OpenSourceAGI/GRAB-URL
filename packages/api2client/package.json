{
  "name": "api2client",
  "version": "2.0.0",
  "description": "Hey API client that sends generated OpenAPI SDK requests with grab instead of axios or fetch, adding caching, retries, rate limiting, deduplication and mocks.",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "api2client": "./dist/cli.es.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "swagger",
    "hey-api",
    "heyapi",
    "codegen",
    "client",
    "sdk",
    "grab",
    "fetch",
    "axios",
    "typescript",
    "rest"
  ],
  "dependencies": {
    "grab-url": "^3.0.0"
  },
  "peerDependencies": {
    "@hey-api/openapi-ts": ">=0.60.0"
  },
  "peerDependenciesMeta": {
    "@hey-api/openapi-ts": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "vtempest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/GRAB-URL.git",
    "directory": "packages/api2client"
  },
  "bugs": {
    "url": "https://github.com/OpenSourceAGI/GRAB-URL/issues"
  },
  "homepage": "https://github.com/OpenSourceAGI/GRAB-URL/tree/master/packages/api2client#readme"
}
