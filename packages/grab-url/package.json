{
  "name": "grab-url",
  "description": "Generate Request to API from Browser — The FBEST Request Manager: Functionally Brilliant, Elegantly Simple Tool. One function, zero dependencies, minimalist syntax, with auto-JSON, dedupe, caching, retries, rate-limiting, mock testing, pagination, and loading icons.",
  "type": "module",
  "version": "3.0.1",
  "packageManager": "npm@11.19.1",
  "author": "vtempest <vtempest@github.com>",
  "license": "PROSPER-1.0.0",
  "licenseUrl": "https://rights.institute/prosper",
  "main": "./dist/grab-api-slim.cjs",
  "types": "./dist/grab-api-slim.d.ts",
  "module": "./dist/grab-api-slim.es.js",
  "exports": {
    ".": {
      "types": "./dist/grab-api-slim.d.ts",
      "import": "./dist/grab-api-slim.es.js",
      "require": "./dist/grab-api-slim.cjs"
    },
    "./full": {
      "types": "./dist/grab-api.d.ts",
      "import": "./dist/grab-api.es.js",
      "require": "./dist/grab-api.cjs"
    },
    "./slim": {
      "types": "./dist/grab-api-slim.d.ts",
      "import": "./dist/grab-api-slim.es.js",
      "require": "./dist/grab-api-slim.cjs"
    },
    "./animations": {
      "types": "./dist/animations.d.ts",
      "import": "./dist/animations.es.js",
      "require": "./dist/animations.cjs"
    },
    "./icons/quantum-sphere": {
      "types": "./dist/quantum-sphere.d.ts",
      "import": "./dist/quantum-sphere.es.js",
      "require": "./dist/quantum-sphere.cjs"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.es.js",
      "require": "./dist/log.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "make": "npm run make:icons && npm run make:skill && npm run make:readme && npm run make:docs && npm run build",
    "make:docs": "npx turbo run build --filter=grab-help-docs",
    "make:skill": "node ./scripts/sync-skill-docs.mjs",
    "make:readme": "node ./scripts/sync-root-readme.mjs",
    "make:icons": "npx export-svg-typescript@latest -i ../../packages/loading-animations/src/svg -o ../../packages/loading-animations/src/svg/index.ts",
    "prepublishOnly": "npm run build",
    "ship": "bun x standard-version --release-as patch; rm CHANGELOG.md; npm publish",
    "test:ui": "vitest --ui",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "export-svg-typescript": "^0.1.15",
    "linkedom": "^0.18.12",
    "loading-animations": "*",
    "lucide-react": "^0.555.0",
    "terser": "^5.46.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "fumadocs-mdx"
  ],
  "overrides": {
    "fumadocs-core": "16.8.5",
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "vite": {
      "esbuild": "^0.28.2"
    }
  },
  "keywords": [
    "api",
    "axios",
    "request",
    "browser",
    "tanstack",
    "query",
    "post",
    "mock-api",
    "fetch",
    "http",
    "http-client",
    "rest-client",
    "api-client",
    "fetch-wrapper",
    "request-deduplication",
    "caching",
    "retry",
    "rate-limiting",
    "mock-testing",
    "pagination",
    "infinite-scroll",
    "loading-icons",
    "quantum-sphere",
    "openapi",
    "hey-api",
    "typescript",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/GRAB-URL.git",
    "directory": "packages/grab-url"
  },
  "homepage": "https://grab.js.org",
  "bugs": {
    "url": "https://github.com/OpenSourceAGI/GRAB-URL/issues",
    "email": "vtempest@github.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vtempest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "sideEffects": false,
  "unpkg": "dist/grab-api-slim.es.js",
  "jsdelivr": "dist/grab-api-slim.es.js"
}
