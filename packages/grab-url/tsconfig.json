{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // Recommended for Vite/ESM
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "checkJs": false, // Disable JS type checking
    "noImplicitAny": false,
    "declarationDir": "./dist", // Output dir for .d.ts files
    "outDir": "./dist", // Output directory
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true, // Required for Vite
    // Extensionless on purpose: TypeScript emits a mapped specifier verbatim,
    // so a `.ts` here lands in the published .d.ts and fails for any consumer
    // without `allowImportingTsExtensions`.
    "paths": {
      "grab-url": ["../../packages/grab-api/src/index"],
      "@grab-url/grab-api": ["../../packages/grab-api/src/index"],
      "api2client": ["../../packages/api2client/src/index"],
      "@grab-url/log": ["../../packages/log-json/src/log-json"],
      "@grab-url/loading-animations": ["../../packages/loading-animations/src/svg/index"],
      "@grab-url/grab-url-cli": ["../../packages/grab-url-cli/src/index"],
      "@grab-url/archiver-web": ["../../packages/archiver-web/src/index"]
    }
  },
  "include": [
    "../../packages/**/*.ts",
    "../../packages/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}