{
  "name": "archiver-web",
  "version": "1.1.2",
  "description": "Universal Archive Extractor & Creator using JSZip. Frontend-only, no WASM.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "extract": "./dist/bin-extract.js",
    "compress": "./dist/bin-compress.js"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ship": "bun x standard-version --release-as patch;rm CHANGELOG.md; npm publish",
    "build": "vite build --config ../grab-url/vite.config.ts",
    "test": "tsx test.ts"
  },
  "optionalDependencies": {
    "fflate": "^0.8.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/GRAB-URL.git",
    "directory": "packages/archiver-web"
  },
  "bugs": {
    "url": "https://github.com/OpenSourceAGI/GRAB-URL/issues"
  },
  "homepage": "https://github.com/OpenSourceAGI/GRAB-URL/tree/master/packages/archiver-web#readme"
}
