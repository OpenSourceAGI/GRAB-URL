{
  "name": "loading-animations",
  "version": "1.0.0",
  "description": "Tree-shakable SVG loading spinners and CLI terminal spinner frame data. Zero dependencies.",
  "type": "module",
  "main": "./src/cli/index.js",
  "types": "./dist/svg/index.d.ts",
  "exports": {
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.es.js",
      "require": "./dist/svg/index.cjs.js"
    },
    "./svg/src": "./src/svg/index.ts",
    "./singlediv": {
      "types": "./dist/singlediv/index.d.ts",
      "import": "./dist/singlediv/index.es.js",
      "require": "./dist/singlediv/index.cjs.js"
    },
    "./singlediv/src": "./src/singlediv/index.ts",
    ".": {
      "import": "./src/cli/index.js",
      "require": "./src/cli/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts"
  },
  "keywords": [
    "loading",
    "spinner",
    "animation",
    "svg",
    "cli",
    "terminal",
    "loader",
    "ui",
    "css",
    "singlediv"
  ],
  "author": "vtempest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/GRAB-URL.git",
    "directory": "packages/loading-animations"
  },
  "bugs": {
    "url": "https://github.com/OpenSourceAGI/GRAB-URL/issues"
  },
  "homepage": "https://github.com/OpenSourceAGI/GRAB-URL/tree/master/packages/loading-animations#readme",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
