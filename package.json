{
  "name": "grab-url",
  "description": "Generate Request to API from Browser",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "npm@11.19.1",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSourceAGI/GRAB-URL"
  },
  "workspaces": [
    "packages/*",
    "!packages/native-app-wrapper",
    "grab-help-docs"
  ],
  "main": "./dist/grab-api.cjs.js",
  "types": "./dist/grab-api.d.ts",
  "module": "./dist/grab-api.es.js",
  "bin": {
    "grab-url": "./dist/grab-url-cli.es.js",
    "grab": "./dist/grab-url-cli.es.js",
    "g": "./dist/grab-url-cli.es.js"
  },
  "exports": {
    ".": {
      "types": "./dist/grab-api.d.ts",
      "import": "./dist/grab-api.es.js",
      "require": "./dist/grab-api.cjs.js"
    },
    "./slim": {
      "types": "./dist/grab-api-slim.d.ts",
      "import": "./dist/grab-api-slim.es.js",
      "require": "./dist/grab-api-slim.cjs.js"
    },
    "./animations": {
      "types": "./dist/animations.d.ts",
      "import": "./dist/animations.es.js",
      "require": "./dist/animations.cjs.js"
    },
    "./icons/quantum-sphere": {
      "types": "./dist/quantum-sphere.d.ts",
      "import": "./dist/quantum-sphere.es.js",
      "require": "./dist/quantum-sphere.cjs.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.es.js",
      "require": "./dist/log.cjs.js"
    },
    "./cli": {
      "types": "./dist/grab-url-cli.d.ts",
      "import": "./dist/grab-url-cli.es.js",
      "require": "./dist/grab-url-cli.cjs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts/install-yt-dlp.mjs",
    "src/loading-animations/cli/loading-animations-emojis.js"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "make": "npm run make:icons && npm run make:skill && npm run make:docs && npm run build",
    "make:docs": "npx turbo run build --filter=grab-help-docs",
    "make:skill": "node ./scripts/sync-skill-docs.mjs",
    "make:icons": "npx export-svg-typescript@latest -i ./packages/loading-animations/src/svg -o ./packages/loading-animations/src/svg/index.ts",
    "postinstall": "node ./scripts/install-yt-dlp.mjs --postinstall",
    "ytdlp": "node ./scripts/install-yt-dlp.mjs --force",
    "ytdlp:sidecar": "node ./scripts/install-yt-dlp.mjs --sidecar",
    "prepublishOnly": "npm run build",
    "ship": "bun x standard-version --release-as patch;rm CHANGELOG.md; npm publish",
    "test:ui": "vitest --ui",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cli": "bun src/grab-url-cli/index.ts https://releases.ubuntu.com/24.04.2/ubuntu-24.04.2-live-server-amd64.iso"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "extract-webpage": ">=1.2.310"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "extract-webpage": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "export-svg-typescript": "^0.1.15",
    "loading-animations": "*",
    "lucide-react": "^0.555.0",
    "terser": "^5.46.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "fumadocs-mdx"
  ],
  "overrides": {
    "fumadocs-core": "16.8.5",
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "vite": {
      "esbuild": "^0.28.2"
    }
  },
  "keywords": [
    "api",
    "axios",
    "request",
    "browser",
    "tanstack",
    "query",
    "post",
    "mock-api",
    "fetch",
    "http"
  ]
}