{
  "name": "grab-url-monorepo",
  "description": "Monorepo for grab-url — Generate Request to API from Browser",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "packageManager": "npm@11.19.1",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSourceAGI/GRAB-URL"
  },
  "workspaces": [
    "packages/*",
    "!packages/native-app-wrapper",
    "grab-help-docs"
  ],
  "scripts": {
    "build": "npm run build --workspace grab-url",
    "make": "npm run make:icons && npm run make:skill && npm run make:docs && npm run build",
    "make:docs": "npx turbo run build --filter=grab-help-docs",
    "make:skill": "node ./scripts/sync-skill-docs.mjs",
    "make:icons": "npx export-svg-typescript@latest -i ./packages/loading-animations/src/svg -o ./packages/loading-animations/src/svg/index.ts",
    "postinstall": "node ./packages/grab-url/scripts/install-yt-dlp.mjs --postinstall",
    "ytdlp": "node ./packages/grab-url/scripts/install-yt-dlp.mjs --force",
    "ytdlp:sidecar": "node ./packages/grab-url/scripts/install-yt-dlp.mjs --sidecar",
    "ship": "bun x standard-version --release-as patch; rm CHANGELOG.md; npm run build && npm publish --workspace grab-url",
    "test:ui": "vitest --ui",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cli": "bun packages/grab-url-cli/src/index.ts https://releases.ubuntu.com/24.04.2/ubuntu-24.04.2-live-server-amd64.iso"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "export-svg-typescript": "^0.1.15",
    "loading-animations": "*",
    "lucide-react": "^0.555.0",
    "terser": "^5.46.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "fumadocs-mdx"
  ],
  "overrides": {
    "fumadocs-core": "16.8.5",
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "vite": {
      "esbuild": "^0.28.2"
    }
  }
}
