# dependencies (bun install)
node_modules

# build output — `npm run build` writes it, git never tracks it.
# npm still ships it: each package.json's "files" whitelist names dist, and a
# "files" entry cannot be excluded by .gitignore, so `npm publish` (which runs
# the build first via prepublishOnly) packs a freshly built dist every time.
dist
# ...except the Tauri wrapper's dist/, which is hand-written source served as
# frontendDist (see packages/native-app-wrapper/src-tauri/tauri.conf.json),
# not build output.
!packages/native-app-wrapper/dist/
*lock.json
# output
out
*.tgz
bun.lockb

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

